Q1

Display employee name and department name.

SELECT e.name , d.department_name
FROM employees e
join department d
ON e.department_id = d.department_id;


Q2

Display employee name and salary for employees who belong to the IT department.

SELECT e.name , e.salary
FROM employees e 
join departments d 
ON e.department_id = d.department_id
where d.department_name = "IT";


Q3

Display employee name, salary, and department name for employees earning more than 60,000.

SELECT e.name , e.salary , d.department_name
FROM employees e 
JOIN department d 
ON e.department_id = d.department_id
WHERE salary>60000;


Q4

Display department name and employee name, sorted by salary from highest to lowest.

SELECT e.name , d.department_name
FROM employees e 
JOIN department d 
ON e.department_id = d.department_id
ORDER BY salary DESC;
Q5

Display only employees who belong to HR, showing:

SELECT *
FROM employees e 
JOIN department d 
ON e.department_id = d.department_id
WHERE d.department_name = 'HR';